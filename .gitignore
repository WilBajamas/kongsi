# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/flutter_sdk/

# Configs
/config/*.json
!/config/*.example.json

# CI-decoded secret (service account key) — only ever written on the runner.
/firebase-service-account.json

# fastlane artifacts + locally-installed gems
android/fastlane/report.xml
android/fastlane/Preview.html
android/fastlane/README.md
android/.bundle/
android/vendor/

# Android
android/.kotlin/

# Alchemist platform goldens are OS-specific; CI asserts goldens/ci only.
test/**/goldens/windows/
test/**/goldens/macos/
test/**/goldens/linux/

# Golden failure diffs are debug artifacts.
test/**/failures/